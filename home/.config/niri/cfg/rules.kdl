    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
	open-maximized true
    }

    window-rule {
        match app-id="Handy"
        open-focused false
        open-floating true
    }

    // Handy recording pill: transparent 256x200 window, keep it bottom-center without niri's border fill
    window-rule {
        match app-id="Handy" title="^Recording$"
        default-floating-position x=0 y=24 relative-to="bottom"
        focus-ring { off; }
        border { off; }
        shadow { off; }
        draw-border-with-background false
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

    // Игры: без скруглений и клипа (иначе не работает direct scanout),
    // VRR включается только пока игра на экране (on-demand)
    window-rule {
        match app-id="^steam_app_"
        match app-id="^gamescope"
        geometry-corner-radius 0
        clip-to-geometry false
        variable-refresh-rate true
    }
